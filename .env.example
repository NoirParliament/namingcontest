# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Where each value comes from: docs/GOING-LIVE.md §3.

# Supabase → Project Settings → API. Safe to expose to the browser —
# RLS protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe → Developers → API keys. The PUBLISHABLE key (pk_test_...) —
# the secret key never goes in the client, it lives in Supabase secrets.
# Without this, checkout renders but the card form cannot mount.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional. Set = the site sits behind a soft password gate. Leave UNSET for
# local dev and for public launch (unset = gate off).
# VITE_BETA_PASSWORD=            # internal/admin access code
# VITE_BETA_TESTER_PASSWORD=     # BETA-ONLY: separate code to give external
                                 # testers; revoke independently by unsetting it
